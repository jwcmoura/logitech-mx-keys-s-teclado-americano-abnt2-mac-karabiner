          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "backslash",
            "modifiers": { "mandatory": ["option", "shift"] }
          },
          "to": [{ "key_code": "grave_accent_and_tilde", "modifiers": ["left_shift"] }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "vendor_id": 1133, "product_id": 45944 }] }
          ]
        },
        {
          "type": "basic",
